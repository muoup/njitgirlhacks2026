PORT=3001
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_ORIGINS=http://localhost:3000
# Generate with: openssl rand -base64 32
# A random, per-process secret is used when omitted in development.
BETTER_AUTH_SECRET=
SEED_DEMO_ACCOUNT=true

# Set both to enable Google login. Register this redirect URI with Google:
# http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: enables Gemini through Vertex AI, billed to this Cloud project.
# Use the project ID linked to your trial-credit billing account.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Local credentials: gcloud auth application-default login
#                   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
# GOOGLE_APPLICATION_CREDENTIALS may instead point to a credentials file outside the repo.
# GEMINI_API_KEY / GOOGLE_VERTEX_API_KEY are not used by this project-scoped provider.
# Set false to disable the periodic worker; authenticated forced refresh still works.
AGENT_SCHEDULE_ENABLED=true
